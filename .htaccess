Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Dossiers et fichiers cachés (.git, .env, .vscode...) : jamais servis
    RewriteRule (^|/)\. - [F,L]

    # Code interne, dépendances, données et journaux : jamais servis
    RewriteRule ^(config|includes|vendor|database|logs|tools|exports|uploads)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env.*|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|README.*|readme\.md|Arborescence|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(log|sql|bak|old|orig|swp|ini|conf|yml|yaml|md|txt|sh|bat|ps1|dist|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header unset X-Powered-By
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
