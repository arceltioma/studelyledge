Options -Indexes

<FilesMatch "^(\\.env|composer\\.json|composer\\.lock|package\\.json|package-lock\\.json|phpunit\\.xml|README|readme\\.md|\\.gitignore)$">
    Require all denied
</FilesMatch>

<FilesMatch "\\.(log|sql|bak|ini|conf|yml|yaml|md|txt|sh|bat|ps1)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>